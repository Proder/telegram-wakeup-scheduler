{
  "name": "Telegram Wake-up Call Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "telegram-wakeup-bot",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"text\"]}}",
              "operation": "regex",
              "value2": "^\\d{1,2}:\\d{2}|tomorrow|day after tomorrow"
            }
          ]
        }
      },
      "name": "Check Time Format",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract message details\nconst message = $input.all()[0].json.message;\nconst timeText = message.text.trim();\nconst userId = message.from.id.toString();\nconst chatId = message.chat.id;\n\n// Parse different time formats\nlet timeString = timeText;\n\n// Handle commands like \"/cancel\", \"/snooze\", \"/status\"\nif (timeText.startsWith('/')) {\n  return [{\n    json: {\n      command: timeText.toLowerCase(),\n      userId: userId,\n      chatId: chatId,\n      isCommand: true\n    }\n  }];\n}\n\n// Validate time format\nconst timeRegex = /^(\\d{1,2}):(\\d{2})$/;\nconst tomorrowRegex = /tomorrow\\s+(\\d{1,2}):(\\d{2})/i;\nconst dayAfterRegex = /day after tomorrow\\s+(\\d{1,2}):(\\d{2})/i;\n\nlet isValid = false;\nlet extractedTime = '';\n\nif (tomorrowRegex.test(timeText)) {\n  isValid = true;\n  extractedTime = timeText;\n} else if (dayAfterRegex.test(timeText)) {\n  isValid = true;\n  extractedTime = timeText;\n} else if (timeRegex.test(timeText)) {\n  isValid = true;\n  extractedTime = timeText;\n}\n\n// Make sure to replace this with your actual phone number\n// Include the country code (e.g., +1 for US)\nconst phoneNumber = \"+919876543210\";\n\nreturn [{\n  json: {\n    timeString: extractedTime,\n    userId: userId,\n    chatId: chatId,\n    phoneNumber: phoneNumber,\n    message: \"Wake up! Time to start your day!\",\n    isValid: isValid,\n    isCommand: false,\n    originalText: timeText\n  }\n}];"
      },
      "name": "Parse Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$node[\"Parse Message\"].json[\"isCommand\"]}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"Parse Message\"].json[\"command\"]}}",
              "value2": "/cancel"
            }
          ]
        }
      },
      "name": "Command Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "options": {
          "allMatchingOutputs": false
        },
        "rules": {
          "rules": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$node[\"Parse Message\"].json[\"command\"]}}",
                    "value2": "/cancel"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "cancel"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$node[\"Parse Message\"].json[\"command\"]}}",
                    "value2": "/snooze"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "snooze"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$node[\"Parse Message\"].json[\"command\"]}}",
                    "value2": "/status"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "status"
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "url": "https://telegram-wakeup-scheduler.onrender.com/set-alarm",
        "options": {
          "bodyContentType": "json",
          "jsonParameters": true,
          "body": {
            "timeString": "={{$node[\"Parse Message\"].json[\"timeString\"]}}",
            "phoneNumber": "={{$node[\"Parse Message\"].json[\"phoneNumber\"]}}",
            "message": "={{$node[\"Parse Message\"].json[\"message\"]}}",
            "userId": "={{$node[\"Parse Message\"].json[\"userId\"]}}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "method": "POST"
      },
      "name": "Set Alarm API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://telegram-wakeup-scheduler.onrender.com/cancel-alarm",
        "options": {
          "bodyContentType": "json",
          "jsonParameters": true,
          "body": {
            "userId": "={{$node[\"Parse Message\"].json[\"userId\"]}}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "method": "POST"
      },
      "name": "Cancel Alarm API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1340,
        350
      ]
    },
    {
      "parameters": {
        "url": "https://telegram-wakeup-scheduler.onrender.com/snooze-alarm",
        "options": {
          "bodyContentType": "json",
          "jsonParameters": true,
          "body": {
            "userId": "={{$node[\"Parse Message\"].json[\"userId\"]}}",
            "minutes": 10
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "method": "POST"
      },
      "name": "Snooze Alarm API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1340,
        450
      ]
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Parse Message\"].json[\"chatId\"]}}",
        "text": "=✅ Alarm set for {{$node[\"Set Alarm API\"].json[\"scheduledTime\"]}} IST\\n⏰ You'll receive a wake-up call in {{$node[\"Set Alarm API\"].json[\"delayMinutes\"]}} minutes\\n\\nCommands:\\n/cancel - Cancel alarm\\n/snooze - Snooze for 10 minutes\\n/status - Check alarm status"
      },
      "name": "Success Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1340,
        200
      ],
      "credentials": {
        "telegramApi": {
